# Host-side configuration for virt-box. Copy to .env and adjust:
#   cp .env.example .env
VM_NAME="virt-box"
VM_RAM_MB="16384"
VM_VCPUS="8"
VM_OS_DISK_SIZE="100G"
VM_OS_DISK_DIR="/var/lib/libvirt/images"
VM_BACKUP_DISK_SIZE="100G"
# Override to place the backup qcow2 on a secondary physical drive, e.g.:
# VM_BACKUP_DISK_DIR="/mnt/secondary-drive/virt-box-backups"
VM_BACKUP_DISK_DIR="/var/lib/libvirt/images"
VM_LIBVIRT_NETWORK="default"
FLAKE_ATTR="virt-box"
